# Copy to .env and fill in. .env is gitignored — never commit it.

# --- External Postgres (CIA database) ---
CIA_PG_HOST=
CIA_PG_PORT=5432
CIA_PG_DB=
CIA_PG_USER=
CIA_PG_PASSWORD=
# Schema holding hauls / haul_catch (grid tables are configured in inst/config/grids.yaml)
CIA_PG_SCHEMA=data

# --- Local storage (host folder mounted at /data in the container) ---
# Defaults to %LOCALAPPDATA%\cia-data-requests when unset.
# CIA_DATA_DIR=C:/Users/<you>/AppData/Local/cia-data-requests

# --- Upload ---
# Fixed upload root: rclone remote name plus base folder. Each request's Drive
# folder name is appended, e.g. gdrive:Data Requests/2026-031 Org X
CIA_RCLONE_REMOTE=gdrive:Data Requests
# Folder holding rclone.conf on this machine (run `rclone config file` to check).
# Defaults to %APPDATA%\rclone when unset.
# RCLONE_CONFIG_DIR=C:/Users/<you>/AppData/Roaming/rclone
